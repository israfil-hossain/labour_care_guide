{
  "name": "labour-care-guide",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "env:dev": "node app/config/environments/scripts/set-environment.js development",
    "env:staging": "node app/config/environments/scripts/set-environment.js staging",
    "env:prod": "node app/config/environments/scripts/set-environment.js production",
    "ios:dev:debug": "yarn env:dev && expo start --ios",
    "ios:staging:debug": "yarn env:staging && expo start --ios",
    "ios:prod:debug": "yarn env:prod && expo start --ios",
    "android:dev:debug": "yarn env:dev && expo start --android",
    "android:staging:debug": "yarn env:staging && expo start --android",
    "android:prod:debug": "yarn env:prod && expo start --android",
    "prebuild": "expo prebuild && node scripts/fix-android-booleans.js",
    "prebuild:clean": "expo prebuild --clean && node scripts/fix-android-booleans.js",
    "fix:android": "node scripts/fix-android-booleans.js",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "test": "jest",
    "lint": "eslint app",
    "lintFix": "eslint --fix",
    "pretty": "prettier --semi true --print-width 100 --single-quote --write",
    "clean": "rm -rf .expo && rm -rf node_modules && yarn install",
    "clean:ios": "rm -rf ios/build",
    "clean:android": "rm -rf android/build && rm -rf android/app/build",
    "pods": "cd ios && pod install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && pretty-quick --staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "yarn run pretty",
      "git add"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "^1.4.10",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native/normalize-color": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@twotalltotems/react-native-otp-input": "^1.3.11",
    "axios": "^1.7.0",
    "better-auth": "^1.4.10",
    "expo": "^54.0.13",
    "expo-clipboard": "^8.0.7",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.16",
    "expo-device": "^8.0.9",
    "expo-document-picker": "^14.0.7",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.9",
    "expo-image": "^3.0.9",
    "expo-image-picker": "^17.0.8",
    "expo-linking": "~8.0.11",
    "expo-media-library": "^18.2.0",
    "expo-network": "^8.0.8",
    "expo-router": "~6.0.21",
    "expo-screen-orientation": "^9.0.7",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "^31.0.10",
    "expo-status-bar": "~3.0.9",
    "microdiff": "^1.5.0",
    "moment": "^2.29.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-modal": "^13.0.0",
    "react-native-modal-datetime-picker": "^13.1.2",
    "react-native-permissions": "^3.3.1",
    "react-native-reanimated": "^4.2.1",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-svg-transformer": "^1.0.0",
    "react-native-toast-message": "^2.1.1",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "^0.7.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.16.5",
    "@babel/eslint-parser": "^7.16.5",
    "@babel/preset-env": "7.16.5",
    "@babel/preset-flow": "7.16.5",
    "@babel/runtime": "^7.16.5",
    "@expo/cli": "^54.0.11",
    "@react-native-community/eslint-config": "^3.0.1",
    "@types/react": "~19.1.17",
    "babel-jest": "^27.4.5",
    "babel-loader": "8.2.3",
    "babel-plugin-react-native-web": "0.17.5",
    "babel-plugin-transform-inline-environment-variables": "0.4.3",
    "babel-plugin-transform-remove-console": "6.9.4",
    "babel-preset-expo": "^54.0.6",
    "core-js": "3.20.1",
    "esdoc": "^1.1.0",
    "esdoc-standard-plugin": "^1.0.0",
    "eslint": "^8.5.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.28.0",
    "husky": "7.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "lint-staged": "12.1.4",
    "prettier": "2.5.1",
    "pretty-quick": "3.1.3",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.0.1",
    "reactotron-redux": "^3.1.3",
    "reactotron-redux-saga": "^4.2.3",
    "redux-mock-store": "^1.5.4"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "pnpm": {
    "overrides": {
      "@react-native-community/clipboard": "npm:expo-clipboard@^8.0.7"
    }
  }
}
