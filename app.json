{
  "expo": {
    "name": "LabourCareGuide",
    "slug": "labour-care-guide",
    "scheme": "lcgapp",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./src/assets/images/splash/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.flowentech.labour-care-guide",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select photos.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for video recording."
      }
    },
    "android": {
      "package": "com.labourcareguide.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withFirebasePodfile",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain"
        }
      ],
      "./plugins/withFixAndroidBooleans",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload documents.",
          "cameraPermission": "The app needs access to your camera to take photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Labour Care Guide to access your photos.",
          "savePhotosPermission": "Allow Labour Care Guide to save photos."
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    },
    "owner": "your-expo-username",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/your-project-id-here"
    }
  }
}
